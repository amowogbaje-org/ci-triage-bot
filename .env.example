# Copy to .env for local testing (never commit the real .env)

GH_APP_ID=123456
# Paste the full PEM contents, or a path-read into this var in your local runner
GH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional: only needed if auto-discovery via /repos/{owner}/{repo}/installation fails
GH_APP_INSTALLATION_ID=

ANTHROPIC_API_KEY=sk-ant-...

GITHUB_REPOSITORY=your-org/your-repo
# Point this at a sample workflow_run event payload for local testing
GITHUB_EVENT_PATH=./sample_event.json
